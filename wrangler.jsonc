    "SM_GUILD_ID": "1567856303341051905",
    "SM_COMMAND_CHANNEL_ID": "1568200051891642388",
    "SM_RELEASE_CHANNEL_ID": "1568145030500057098",
    "SM_ACTION_CHANNEL_ID": "1568145100683485184",
    "SM_BETA_CHANNEL_ID": "1568234962619072532",
    "SM_DEVELOPMENT_BRANCH": "master",
    "SM_STATS_ENABLED": "false",
    "SM_NOTIFICATIONS_ENABLED": "false",
    "SM_MIGRATION_ENABLED": "false"
  }
}
