{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sparkling-mutuals-discord",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
